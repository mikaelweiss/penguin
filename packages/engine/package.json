{
  "name": "@mikaelweiss/penguin-engine",
  "private": true,
  "description": "the penguin core definitions and catalog discovery",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./view": {
      "types": "./src/core/view.ts",
      "default": "./src/core/view.ts"
    },
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "default": "./src/catalog/index.ts"
    },
    "./run": {
      "types": "./src/run.ts",
      "default": "./src/run.ts"
    },
    "./describe": {
      "types": "./src/describe.ts",
      "default": "./src/describe.ts"
    }
  },
  "files": ["src", "examples"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "bun-pty": "0.4.8",
    "zod": "^4.4.3"
  },
  "nx": {
    "tags": ["scope:engine"],
    "targets": {
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true
      }
    }
  }
}
