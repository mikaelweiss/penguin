{
  "name": "@mikaelweiss/penguin",
  "version": "0.0.4",
  "description": "Run one workflow file as a live process, with any coding agent CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelweiss/penguin.git"
  },
  "type": "module",
  "bin": {
    "pn": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "examples"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "release": "./scripts/publish.sh",
    "reinstall": "./scripts/reinstall.sh"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
