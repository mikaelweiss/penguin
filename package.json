{
  "name": "penguin",
  "private": true,
  "version": "0.0.9",
  "description": "Run one workflow file as a live process, with any coding agent CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelweiss/penguin.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "check": "tsc --noEmit && eslint .",
    "test": "bun test --parallel --timeout 30000 test/",
    "generate": "./scripts/generate-starter.ts",
    "build": "./scripts/build.ts",
    "publish": "./scripts/publish.ts",
    "reinstall": "./scripts/reinstall.sh",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^22.4.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.0",
    "nx": "^22.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
