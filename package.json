{
  "name": "penguin",
  "private": true,
  "version": "0.0.9",
  "description": "Run one workflow file as a live process, with any coding agent CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelweiss/penguin.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "check": "tsc --noEmit && nx run-many -t typecheck && eslint .",
    "desktop": "nx serve desktop",
    "docs": "nx serve docs",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^23.1.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "nx": "^22.4.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8.67.0"
  }
}
