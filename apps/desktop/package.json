{
  "name": "@mikaelweiss/penguin-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "the penguin desktop app",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "tauri icon app-icon.svg && rm -rf src-tauri/icons/android src-tauri/icons/ios && bun scripts/normalize-icns.ts"
  },
  "dependencies": {
    "@mikaelweiss/penguin-engine": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@workspace/terminal": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.9",
    "vite": "^7.0.4"
  },
  "nx": {
    "name": "desktop",
    "tags": [
      "scope:desktop"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -b",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true
      },
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true
      },
      "serve": {
        "command": "tauri dev",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
