{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "penguin",
  "version": "0.1.0",
  "identifier": "org.weisssolutions.penguin",
  "build": {
    "beforeDevCommand": "bun scripts/bundle-engine.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/bundle-engine.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "penguin",
        "width": 1100,
        "height": 780,
        "minWidth": 840,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/bun"],
    "resources": ["engine/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
