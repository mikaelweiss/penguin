{
  // "paths" points at the penguin install. Run `npm root -g` to find it.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "penguin": ["./node_modules/penguin/dist/index.d.ts", "../src/index.ts"],
      "zod": ["./node_modules/penguin/node_modules/zod", "./node_modules/zod", "../node_modules/zod"]
    }
  },
  "include": ["*.ts", "adapters/*.ts"]
}
